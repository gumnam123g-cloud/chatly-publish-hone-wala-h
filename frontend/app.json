{
  "expo": {
    "name": "Chatly AI Messenger",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.aimessenger.bq2ltq",
      "infoPlist": {
        "NSCameraUsageDescription": "Show your video on calls and send photos in chats",
        "NSPhotoLibraryUsageDescription": "Share photos from your library in chats",
        "NSMicrophoneUsageDescription": "Talk on voice and video calls and record voice messages"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF5E00"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.chatly.ai.messenger.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "WRITE_EXTERNAL_STORAGE",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-audio",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Share photos from your library in chats",
          "cameraPermission": "Take and send photos in your chats"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan Chatly QR codes to add friends"
        }
      ],
      "expo-video",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Show your video on calls and send photos in chats",
          "microphonePermission": "Talk on voice and video calls and record voice messages"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF5E00"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Save photos and videos you receive to your gallery",
          "savePhotosPermission": "Save received media to your gallery",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}