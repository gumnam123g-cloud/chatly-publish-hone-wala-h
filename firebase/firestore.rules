rules_version = '2';
// Chatly Firestore security rules.
// Deploy:  firebase deploy --only firestore:rules  (from a dir with firebase.json)
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Public profile mirror (name/username/avatar/qr_token). Readable by any signed-in
    // user for search + QR resolution; only the owner (or backend Admin SDK) may write.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSelf(userId);
    }

    // Username uniqueness index: doc id == lowercase username -> { uid }.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Chats: only participants can read; writes go through the backend / participants.
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.sender_id == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // edits/deletes limited to the sender
        allow update, delete: if isSignedIn() && resource.data.sender_id == request.auth.uid;
      }
    }

    // Per-user private collections.
    match /tasks/{docId}      { allow read, write: if isSignedIn() && resource.data.user_id == request.auth.uid;
                                 allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid; }
    match /reminders/{docId}  { allow read, write: if isSignedIn() && resource.data.user_id == request.auth.uid;
                                 allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid; }
    match /statuses/{docId}   { allow read: if isSignedIn();
                                 allow write: if isSignedIn() && resource.data.user_id == request.auth.uid;
                                 allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid; }
    match /fcm_tokens/{docId} { allow read, write: if isSignedIn() && resource.data.user_id == request.auth.uid;
                                 allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid; }

    // Deny everything else by default.
    match /{document=**} { allow read, write: if false; }
  }
}
